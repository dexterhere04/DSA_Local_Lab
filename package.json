{
  "name": "dsa-lab-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Lightweight self-hosted AI-powered DSA practice platform",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @dsa-lab/backend db:generate",
    "db:migrate": "pnpm --filter @dsa-lab/backend db:migrate"
  }
}
